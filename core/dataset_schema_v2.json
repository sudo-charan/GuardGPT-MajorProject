{
  "_schema_version": "2.0",
  "_description": "GuardGPT canonical harm dataset schema. Every record MUST conform to this structure.",

  "_taxonomy": {
    "intent_labels": [
      "safe",
      "self_harm_risk",
      "violence_threat",
      "hate_speech",
      "illegal_activity",
      "child_exploitation",
      "terrorism",
      "cybercrime",
      "drug_synthesis",
      "weapon_synthesis",
      "harmful_instructions",
      "manipulation",
      "financial_fraud",
      "privacy_violation",
      "misinformation",
      "prompt_injection"
    ],
    "risk_levels": ["safe", "low", "medium", "high", "critical"],
    "category_score_keys": ["harm", "jailbreak", "toxicity", "prompt_injection"],
    "split_values": ["train", "val", "test"],
    "reason_code_values": [
      "high_harm_score",
      "jailbreak_attempt",
      "high_toxicity",
      "prompt_injection_detected",
      "bypass_phrase_detected"
    ]
  },

  "_field_definitions": {
    "request_id":         "STRING  – Unique record identifier. Format: uuid4 string.",
    "intent":             "STRING  – Canonical unsafe-intent label (see taxonomy above).",
    "input_text":         "STRING  – The original harmful or test prompt text (required for TF-IDF indexing).",
    "category_scores":    "OBJECT  – All four float keys MUST be present (harm, jailbreak, toxicity, prompt_injection). Range 0.0–1.0.",
    "reason_codes":       "ARRAY   – Machine-readable list of triggered rules. May be empty [] for safe records.",
    "risk_level":         "STRING  – Pre-computed risk level for this record (see risk_levels).",
    "split":              "STRING  – Dataset partition: train | val | test.",
    "source":             "STRING  – Origin tag, e.g. 'anthropic_redteam', 'synthetic_v2', 'hh_rlhf'.",
    "language":           "STRING  – ISO 639-1 language code, e.g. 'en'. Default 'en'.",
    "created_at":         "STRING  – ISO-8601 UTC timestamp of record creation.",
    "annotator_id":       "STRING  – Optional. ID of human annotator for labelled records.",
    "confidence":         "FLOAT   – Optional. Annotator confidence in [intent, risk_level] labels (0.0–1.0)."
  },

